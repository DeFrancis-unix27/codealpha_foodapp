### ============================================
### AUTHENTICATION ENDPOINTS
### ============================================

### Register a new user
POST http://127.0.0.1:8000/api/register/
Content-Type: application/json

{
  "first_name":"jack",
  "last_name":"pupil",
  "username": "oliva",
  "email": "keliven@gmail.com",
  "password": "davenlab",
  "confirm_password":"davenlab",
  "role": "manager",
  "phone_number":"09045439303"
}

### Login (Get JWT Token)
POST http://127.0.0.1:8000/api/login/
Content-Type: application/json

{
  "username": "pope",
  "password": "davenlab"
}

### Logout
POST http://127.0.0.1:8000/api/logout/
Content-Type: application/json
Authorization: Bearer YOUR_TOKEN_HERE

{
}

### Delete Account
POST http://127.0.0.1:8000/api/delacc/
Authorization: Bearer YOUR_TOKEN_HERE

### ============================================
### RESTAURANT ENDPOINTS
### ============================================

### Create Restaurant (Manager only)
POST http://127.0.0.1:8000/api/create_resturant/
Content-Type: application/json
Authorization: Bearer {{manager_Bearer_token}}

{
  "owner":"{{manager_uuid}}",
  "name": "Pizza Palace",
  "description": "Best pizza in town",
  "location": "123 Main St",
  "email": "contact@pizzapalace.com",
  "opening_time": "09:00:00",
  "closing_time": "22:00:00"
}

### List All Restaurants
GET http://127.0.0.1:8000/api/list_resturant/

### Retrieve Restaurant Details
GET http://127.0.0.1:8000/api/retrive_resturant/1/
Authorization: Bearer {{manager_Bearer_token}}

### Update Restaurant
PUT http://127.0.0.1:8000/api/update_resturant/1/
Content-Type: application/json
Authorization: Bearer {{manager_Bearer_token}}

{
  "name": "Pizza Palace Updated",
  "opening_time": "10:00:00"
}

### Delete Restaurant
DELETE http://127.0.0.1:8000/api/delete_resturant/1/
Authorization: Bearer YOUR_TOKEN_HERE

### ============================================
### STAFF INVITATION ENDPOINTS
### ============================================

### Create Staff Invite
POST http://127.0.0.1:8000/api/create_invitestaff/
Content-Type: application/json
Authorization: Bearer {{manager_Bearer_token}}

{
  "Resturant": 1,
  "invited_by":"{{manager_uuid}}",
  "Staff": "{{customer_uuid}}",
  "role": "waiter",
  "message": "Join our team as a chef",
  "expiring":"2026-12-20"
}

### List Staff Invites
GET http://127.0.0.1:8000/api/list_invitestaff/
Authorization: Bearer {{customer_Bearer_token}}

### Retrieve Invite Details
GET http://127.0.0.1:8000/api/retrive_invitestaff/1/
Authorization: Bearer {{customer_Bearer_token}}

### Accept Invite
POST http://127.0.0.1:8000/api/accept_invite/cb092abc-b528-434f-9019-04452f659a28/
Authorization: Bearer {{customer_Bearer_token}}

### Reject Invite
POST http://127.0.0.1:8000/api/reject_invite/0acf0835-360f-40bd-8c26-9dde98381fdb/
Authorization: Bearer YOUR_TOKEN_HERE

### Delete Invite
DELETE http://127.0.0.1:8000/api/delete_invitestaff/1/
Authorization: Bearer YOUR_TOKEN_HERE

